<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>grasping_omron_moma</name>
  <version>0.1.0</version>
  <description>Launch files for the Omron LD-250 and TM12X grasping platform</description>
  <maintainer email="kalanaratnayake95@gmail.com">ubuntu</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>grasping_control</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ld250_tm12x_soft_two_fingers_moveit_config</exec_depend>
  <exec_depend>moma_ros</exec_depend>
  <exec_depend>mobile_manipulator_control</exec_depend>
  <exec_depend>mobile_manipulator_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
